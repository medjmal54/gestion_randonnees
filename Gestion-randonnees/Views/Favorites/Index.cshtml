@model IReadOnlyList<Hike>
@{
    ViewData["Title"] = "Mes favoris";
}
<h1>Mes favoris</h1>
@if (Model == null || !Model.Any())
{
    <p>Aucun favori pour le moment.</p>
}
else
{
    <div class="row g-3">
        @foreach (var hike in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@hike.Titre</h5>
                        <p class="text-muted mb-1">@hike.Region · @hike.Difficulte</p>
                        <p class="mb-2">@hike.Prix.ToString("0.##") DT</p>
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Hikes" asp-action="Details" asp-route-id="@hike.Id">Détails</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
